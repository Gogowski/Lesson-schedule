# Firebase web-app settings from Project settings > Your apps.
# These values are public client configuration; Firestore rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# UID of the one account allowed to edit the schedule.
VITE_SCHEDULE_EDITOR_UID=

# Supabase Free web settings. Keep only the publishable/anon key in the browser.
# Never put a Supabase service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
